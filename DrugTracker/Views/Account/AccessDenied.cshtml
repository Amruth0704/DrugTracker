@{
    ViewData["Title"] = "Access Denied";
}

<div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
    <i class="bi bi-shield-lock-fill lock-icon"></i>
    <h1 class="text-danger fw-bold mb-3">Access Denied</h1>
    <p class="lead text-muted text-center mb-4">You do not have the required permissions to access this area.<br>Please contact your administrator or log in with a different account.</p>
    
    <div class="d-flex gap-3">
        <a asp-controller="Account" asp-action="RedirectToDashboard" class="btn btn-outline-secondary px-4">
            <i class="bi bi-speedometer2"></i> Return to Dashboard
        </a>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-primary px-4">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>
</div>
