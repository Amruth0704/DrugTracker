@model IEnumerable<DrugTracker.Models.Inventory>

@{
    ViewData["Title"] = "Pharmacy Dashboard";
    var incoming = ViewBag.Incoming as IEnumerable<DrugTracker.Models.DrugBatch>;
}

<div class="container-fluid">
    <h2 class="mt-4"><i class="bi bi-hospital"></i> Pharmacy Dashboard</h2>
    <hr />

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Incoming Batches Section -->
    <div class="card mb-4">
        <div class="card-header bg-warning text-dark">
            <h4><i class="bi bi-arrow-down-circle"></i> Incoming Batches (Pending Acceptance)</h4>
        </div>
        <div class="card-body">
            @if(incoming != null && incoming.Any()) {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Batch ID</th>
                            <th>Drug Name</th>
                            <th>Quantity</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in incoming)
                        {
                            <tr>
                                <td>@item.DrugBatchId</td>
                                <td>@item.Drug?.DrugName</td>
                                <td>@item.QuantityProduced</td>
                                <td>
                                    <form asp-action="Accept" method="post">
                                        <input type="hidden" name="batchId" value="@item.DrugBatchId" />
                                        <button type="submit" class="btn btn-success btn-sm">Accept</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            } else {
                <p>No incoming batches.</p>
            }
        </div>
    </div>

    <!-- Inventory Section -->
    <div class="card">
        <div class="card-header bg-success text-white">
            <h4><i class="bi bi-capsule"></i> Current Inventory</h4>
        </div>
        <div class="card-body">
             @if(Model != null && Model.Any()) {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Batch ID</th>
                            <th>Drug Name</th>
                            <th>Available Qty</th>
                            <th>Expiry</th>
                            <th>Sell</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DrugBatchId</td>
                                <td>@item.DrugBatch?.Drug?.DrugName</td>
                                <td class="fw-bold">@item.AvailableQty</td>
                                <td>@* We need batch details. Inventory has BatchId but not nav property in model shown early? 
                                       Let's check Inventory model. It has string DrugBatchId. *@
                                    @item.DrugBatchId @* Ideally join to get Expiry *@
                                </td>
                                <td>
                                    <form asp-action="Sell" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="batchId" value="@item.DrugBatchId" />
                                        <input type="number" name="quantity" class="form-control form-control-sm w-25" value="1" min="1" max="@item.AvailableQty" />
                                        <button type="submit" class="btn btn-primary btn-sm">Sell</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
             } else {
                 <p>Inventory empty.</p>
             }
        </div>
    </div>
</div>
