@model IEnumerable<DrugTracker.Models.ViewModels.BatchViewModel>

@{
    ViewData["Title"] = "Pharmacy Dashboard";
    int pendingCount = Model.Count(m => m.IsActionEnabled);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <h2><i class="bi bi-hospital text-success"></i> Pharmacy Dashboard <small class="text-muted fs-5 ms-2">(@User.Identity?.Name)</small></h2>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Pending Arrivals</h5>
                        <p class="display-6 fw-bold mb-0">@pendingCount</p>
                    </div>
                    <i class="bi bi-box-seam fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-3">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-3">@TempData["Error"]</div>
    }

    <div class="card text-dark text-decoration-none border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 font-weight-bold text-primary">Incoming Batches</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="py-3 px-3">Batch ID</th>
                            <th>Drug Name</th>
                            <th>Quantity</th>
                            <th>Mfg Date</th>
                            <th>Exp Date</th>
                            <th>Status/Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">No incoming batches.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-3 fw-bold text-primary">@item.Batch.DrugBatchId</td>
                                <td>@item.Batch.Drug?.DrugName</td>
                                <td>@item.Batch.QuantityProduced</td>
                                <td>@item.Batch.ManufactureDate.ToShortDateString()</td>
                                <td>@item.Batch.ExpiryDate.ToShortDateString()</td>
                                <td>
                                    @if (item.IsActionEnabled)
                                    {
                                        <form asp-action="Accept" method="post" style="display:inline;">
                                            <input type="hidden" name="batchId" value="@item.Batch.DrugBatchId" />
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill shadow-sm">
                                                <i class="bi bi-check-circle"></i> Accept Batch
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-light text-success border border-success">
                                            <i class="bi bi-check-lg"></i> In Inventory
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="row g-4">
         <div class="col-md-6">
             <div class="card h-100 shadow-sm border-0">
                 <div class="card-body text-center py-5">
                     <i class="bi bi-box-seam text-primary display-4 mb-3"></i>
                     <h4 class="card-title">Inventory Management</h4>
                     <p class="card-text text-muted">View and monitor current stock and expiry dates.</p>
                     <a asp-action="Inventory" class="btn btn-primary rounded-pill px-4">View Inventory</a>
                 </div>
             </div>
         </div>
         <div class="col-md-6">
             <div class="card h-100 shadow-sm border-0">
                 <div class="card-body text-center py-5">
                     <i class="bi bi-cart-check text-success display-4 mb-3"></i>
                     <h4 class="card-title">Sales Point</h4>
                     <p class="card-text text-muted">Record new sales and update stock levels.</p>
                     <a asp-action="Sales" class="btn btn-success rounded-pill px-4">Record Sales</a>
                 </div>
             </div>
         </div>
    </div>
</div>
