@model IEnumerable<DrugTracker.Models.ViewModels.BatchViewModel>

@{
    ViewData["Title"] = "Pharmacy Dashboard";
    int pendingCount = Model.Count(m => m.IsActionEnabled);
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-5">
         <div>
            <h2 class="mb-1">Pharmacy Dashboard</h2>
            <p class="text-muted">Accept shipments and manage inventory.</p>    
        </div>
         <div class="text-end">
            <span class="badge badge-success">
                 <i class="bi bi-hospital me-1"></i> @User.Identity?.Name
            </span>
        </div>
    </div>

    <!-- Stats -->
    <div class="dashboard-grid mb-4">
         <div class="card-modern" style="border-left: 5px solid #198754;">
            <div class="stat-card">
                <span class="stat-label">Pending Arrivals</span>
                <span class="stat-value text-success">@pendingCount</span>
                 <div class="mt-2 text-muted small">
                     <i class="bi bi-truck me-1"></i> In-transit from Distributor
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
         <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm" role="alert">
             <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Message"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
         <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
             <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="card-modern mb-5">
        <div class="card-header-modern">
             <h4 class="m-0">Incoming Batches</h4>
        </div>
        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Batch ID</th>
                        <th>Drug Name</th>
                        <th>Quantity</th>
                        <th>Mfg Date</th>
                        <th>Exp Date</th>
                        <th>Status/Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No incoming batches found.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-controller="Verification" asp-action="SupplyChain" asp-route-batchId="@item.Batch.DrugBatchId" class="text-primary text-decoration-none">
                                    #@item.Batch.DrugBatchId
                                </a>
                            </td>
                            <td>@item.Batch.Drug?.DrugName</td>
                            <td>@item.Batch.QuantityProduced</td>
                            <td>@item.Batch.ManufactureDate.ToShortDateString()</td>
                            <td>@item.Batch.ExpiryDate.ToShortDateString()</td>
                            <td>
                                @if (item.IsActionEnabled)
                                {
                                    <form asp-action="Accept" method="post" style="display:inline;">
                                        <input type="hidden" name="batchId" value="@item.Batch.DrugBatchId" />
                                        <button type="submit" class="btn btn-sm btn-primary-modern">
                                            <i class="bi bi-check-lg me-1"></i> Accept Batch
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge badge-success">
                                        <i class="bi bi-check-all"></i> In Inventory
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="row g-4">
         <div class="col-md-6">
             <div class="card-modern text-center p-5">
                 <div class="mb-3 text-primary">
                    <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
                 </div>
                 <h3 class="h4 fw-bold">Inventory Management</h3>
                 <p class="text-muted mb-4">View and monitor current stock levels and expiry dates.</p>
                 <a asp-action="Inventory" class="btn btn-primary-modern px-4">View Inventory</a>
             </div>
         </div>
         <div class="col-md-6">
             <div class="card-modern text-center p-5">
                 <div class="mb-3 text-success">
                    <i class="bi bi-cart-check" style="font-size: 3rem;"></i>
                 </div>
                 <h3 class="h4 fw-bold">Sales Point</h3>
                 <p class="text-muted mb-4">Record new sales transactions and update stock.</p>
                 <a asp-action="Sales" class="btn btn-success-modern px-4" style="background-color: #198754; color: white;">Record Sales</a>
             </div>
         </div>
    </div>
</div>
