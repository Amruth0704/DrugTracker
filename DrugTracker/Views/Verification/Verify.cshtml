@model DrugTracker.Models.DrugBatch

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h3>Batch Verification</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Drug Name</dt>
                    <dd class="col-sm-8">@(Model.Drug?.DrugName ?? "Unknown")</dd>

                    <dt class="col-sm-4">Batch ID</dt>
                    <dd class="col-sm-8">@Model.DrugBatchId</dd>

                    <dt class="col-sm-4">Quantity</dt>
                    <dd class="col-sm-8">@Model.QuantityProduced</dd>

                    <dt class="col-sm-4">Manufacture Date</dt>
                    <dd class="col-sm-8">@Model.ManufactureDate.ToShortDateString()</dd>

                    <dt class="col-sm-4">Expiry Date</dt>
                    <dd class="col-sm-8">@Model.ExpiryDate.ToShortDateString()</dd>

                    <dt class="col-sm-4">Manufacturer</dt>
                    <dd class="col-sm-8">@(Model.CreatedByOrg?.OrgName ?? "Unknown")</dd>
                </dl>
                
                <div class="text-center mt-4">
                    @if (Model.ExpiryDate < DateTime.Now)
                    {
                        <div class="alert alert-danger">
                            <h4>EXPIRED</h4>
                            <p>This batch has expired.</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <h4>VALID</h4>
                            <p>This batch is valid.</p>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer text-center">
                <small class="text-muted">Verified by DrugTracker Blockchain</small>
            </div>
        </div>
    </div>
</div>
