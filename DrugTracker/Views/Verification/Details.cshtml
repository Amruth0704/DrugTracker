@model DrugTracker.Models.DrugBatch
@using DrugTracker.Models

@{
    ViewData["Title"] = "Batch Details";
    var history = ViewBag.History as IEnumerable<BatchOwnershipHistory>;
    var ledger = (ViewBag.Ledger as IEnumerable<BlockchainLedger>)?.OrderBy(l => l.ActionTime).ToList();
    
    bool isTampered = false;
    if (ledger != null && ledger.Count > 1)
    {
        for (int i = 1; i < ledger.Count; i++)
        {
            if (ledger[i].PreviousHash != ledger[i - 1].CurrentHash)
            {
                isTampered = true;
                break;
            }
        }
    }
}

<div class="container mt-4">
    @if (isTampered)
    {
        <div class="alert alert-danger shadow-sm mb-4">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> TAMPERING DETECTED!</h4>
            <p>The cryptographic chain for this batch has been broken. The authenticity of this medicine cannot be guaranteed.</p>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-shield-check text-success"></i> Batch Verification: @Model.DrugBatchId</h2>
        <span class="badge bg-primary fs-5">Batch ID / Code</span>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3"><strong>Drug Name:</strong> <br/> @Model.Drug?.DrugName</div>
                <div class="col-md-3"><strong>Manufactured By:</strong> <br/> @Model.CreatedByOrg?.OrgName</div>
                <div class="col-md-3"><strong>Mfg Date:</strong> <br/> @Model.ManufactureDate.ToShortDateString()</div>
                <div class="col-md-3"><strong>Expiry Date:</strong> <br/> @Model.ExpiryDate.ToShortDateString()</div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Journey Timeline</h4>
    <div class="timeline">
        @if(history != null) {
            foreach(var item in history) {
                <div class="card mb-3 border-left-primary shadow-sm">
                    <div class="card-body">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1 text-primary">@item.ActionType</h5>
                            <small>@item.ActionTime.ToString("g")</small>
                        </div>
                        <p class="mb-1">
                            @if(item.ActionType == "CREATED" || item.ActionType == "BATCH_CREATED") {
                                <span>Created by <strong>@Model.CreatedByOrg?.OrgName</strong></span>
                            } else if (item.ToOrg != null) {
                                <span>Transferred to <strong>@item.ToOrg.OrgName</strong> (@item.ToOrg.OrgType)</span>
                            } else {
                                <span>@item.ActionType</span>
                            }
                        </p>
                    </div>
                </div>
            }
        }
    </div>

    <h4 class="mb-3 mt-5">Blockchain Ledger Records (Immutable)</h4>
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Previous Hash</th>
                    <th>Current Hash</th>
                </tr>
            </thead>
            <tbody>
                @if(ledger != null)
                {
                    foreach(var l in ledger)
                    {
                        <tr>
                            <td>@l.ActionTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@l.Action</td>
                            <td>@l.FromOrgId</td>
                            <td>@l.ToOrgId</td>
                            <td><code class="text-muted" title="@l.PreviousHash">@(l.PreviousHash?.Length > 10 ? l.PreviousHash.Substring(0, 10) + "..." : l.PreviousHash)</code></td>
                            <td><code class="text-dark" title="@l.CurrentHash">@(l.CurrentHash?.Length > 10 ? l.CurrentHash.Substring(0, 10) + "..." : l.CurrentHash)</code></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    <div class="mt-4 text-center">
        <a asp-action="Index" class="btn btn-outline-primary">Verify Another Batch</a>
    </div>
</div>

@functions {
    // No extra functions needed for now
}
