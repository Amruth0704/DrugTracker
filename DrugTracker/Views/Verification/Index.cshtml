@{
    ViewData["Title"] = "Track Medicine";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-primary">Verify Your Medicine</h1>
    <p class="lead">Blockchain-secured drug verification system. Enter your Batch ID / Code to see the complete journey.</p>
    
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <form asp-action="Verify" method="get">
                 <div class="input-group mb-3">
                       <input type="text" name="batchId" class="form-control form-control-lg" placeholder="Enter Batch ID / Code (e.g. PAR001)" required>
                      <button class="btn btn-primary btn-lg" type="submit">Verify</button>
                 </div>
             </form>
             @if(ViewBag.Error != null)
             {
                 <div class="alert alert-danger">@ViewBag.Error</div>
             }
        </div>
    </div>
</div>
