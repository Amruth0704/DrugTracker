@model DrugTracker.Models.ViewModels.CreateBatchViewModel

@{
    ViewData["Title"] = "Create Batch";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h3>Create New Drug Batch</h3>
        </div>
        <div class="card-body">
            <form asp-action="CreateBatch">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="DrugId" class="form-label"></label>
                    <select asp-for="DrugId" class="form-select" asp-items="ViewBag.DrugList">
                        <option value="">-- Select Drug --</option>
                    </select>
                    <span asp-validation-for="DrugId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Batch ID</label>
                    <input type="text" class="form-control" value="AUTO-GENERATED (e.g. PAR001)" disabled readonly />
                    <small class="text-muted">Generated automatically based on Drug selection.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" placeholder="Enter Above 100"/>
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ManufactureDate" class="form-label"></label>
                        <input asp-for="ManufactureDate" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ManufactureDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiryDate" class="form-label"></label>
                        <input asp-for="ExpiryDate" class="form-control" readonly style="background-color: #e9ecef;" />
                        <small class="text-muted">Auto-calculated (Manufacture Date + 3 Years)</small>
                        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-success btn-lg">Create Batch</button>
                <a asp-action="Dashboard" class="btn btn-secondary btn-lg">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const mfgDateInput = document.querySelector('input[name="ManufactureDate"]');
            const expDateInput = document.querySelector('input[name="ExpiryDate"]');

            if (mfgDateInput && expDateInput) {
                mfgDateInput.addEventListener('change', function() {
                    const mfgDateValue = this.value;
                    if (mfgDateValue) {
                        const mfgDate = new Date(mfgDateValue);
                        // Add 3 years
                        mfgDate.setFullYear(mfgDate.getFullYear() + 3);
                        
                        // Format to YYYY-MM-DD for input type="date"
                        const year = mfgDate.getFullYear();
                        const month = String(mfgDate.getMonth() + 1).padStart(2, '0');
                        const day = String(mfgDate.getDate()).padStart(2, '0');
                        
                        expDateInput.value = `${year}-${month}-${day}`;
                    }
                });
            }
        });
    </script>
}
