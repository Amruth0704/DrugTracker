@model IEnumerable<DrugTracker.Models.ViewModels.BatchViewModel>

@{
    ViewData["Title"] = "Manufacturer Dashboard";
    int startCount = Model.Count(m => m.LatestAction == "CREATED" || m.LatestAction == "BATCH_CREATED");
    int dispatchCount = Model.Count(m => m.LatestAction == "TRANSFERRED" || m.LatestAction == "RECEIVED" || m.LatestAction == "ACCEPTED");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <h2><i class="bi bi-building text-primary"></i> Manufacturer Dashboard</h2>
        <a asp-action="CreateBatch" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle"></i> Create New Batch
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
         <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Batches</h5>
                    <p class="display-6 fw-bold">@Model.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Ready to Dispatch</h5>
                    <p class="display-6 fw-bold">@startCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title">Dispatched</h5>
                    <p class="display-6 fw-bold">@dispatchCount</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-3">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-3">@TempData["Error"]</div>
    }

    <div class="card text-dark text-decoration-none border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
             <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="py-3 px-3">Batch ID</th>
                            <th>Drug Name</th>
                            <th>Quantity</th>
                            <th>Mfg Date</th>
                            <th>Exp Date</th>
                            <th>Status</th>
                            <th class="text-end px-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-3 fw-bold text-primary">@item.Batch.DrugBatchId</td>
                                <td>@item.Batch.Drug?.DrugName</td>
                                <td>@item.Batch.QuantityProduced</td>
                                <td>@item.Batch.ManufactureDate.ToShortDateString()</td>
                                <td>@item.Batch.ExpiryDate.ToShortDateString()</td>
                                <td>
                                    <span class="badge rounded-pill @(item.LatestAction == "TRANSFERRED" || item.LatestAction == "RECEIVED" || item.LatestAction == "ACCEPTED" ? "bg-warning text-dark" : "bg-success")">
                                        @item.LatestAction
                                    </span>
                                </td>
                                <td class="text-end px-3">
                                    @if (item.IsActionEnabled)
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#dispatchModal-@item.Batch.DrugBatchId">
                                            <i class="bi bi-truck"></i> Dispatch
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light text-muted rounded-pill border" disabled><i class="bi bi-check2"></i> Dispatched</button>
                                    }
                                    
                                    <!-- Modal for Dispatch -->
                                    <div class="modal fade" id="dispatchModal-@item.Batch.DrugBatchId" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="Dispatch" method="post">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Dispatch Batch @item.Batch.DrugBatchId</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        <input type="hidden" name="batchId" value="@item.Batch.DrugBatchId" />
                                                        <div class="mb-3">
                                                            <label class="form-label">Select Distributor</label>
                                                            <select name="distributorId" class="form-select" required>
                                                                <option value="">-- Select Distributor --</option>
                                                                @if(ViewBag.Distributors != null) {
                                                                    foreach(var d in (IEnumerable<dynamic>)ViewBag.Distributors) {
                                                                        <option value="@d.OrgId">@d.OrgName</option>
                                                                    }
                                                                }
                                                                <option value="2">Default Distributor (Demo)</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                                        <button type="submit" class="btn btn-primary">Dispatch</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
