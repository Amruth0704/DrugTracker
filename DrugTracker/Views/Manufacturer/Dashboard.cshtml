@model IEnumerable<DrugTracker.Models.DrugBatch>

@{
    ViewData["Title"] = "Manufacturer Dashboard";
}

<div class="container-fluid">
    <h2 class="mt-4"><i class="bi bi-building"></i> Manufacturer Dashboard</h2>
    <hr />

    <div class="d-flex justify-content-between mb-3">
        <h4>Created Batches</h4>
        <a asp-action="CreateBatch" class="btn btn-success"><i class="bi bi-plus-circle"></i> Create New Batch</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Batch ID</th>
                    <th>Drug Name</th>
                    <th>Quantity</th>
                    <th>Mfg Date</th>
                    <th>Exp Date</th>
                    <th>Status / Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.DrugBatchId</td>
                        <td>@item.Drug?.DrugName</td>
                        <td>@item.QuantityProduced</td>
                        <td>@item.ManufactureDate.ToShortDateString()</td>
                        <td>@item.ExpiryDate.ToShortDateString()</td>
                        <td>
                            @* Check if dispatched? We need to know current status.
                               A hacky way is to check the last ledger entry or keep a Status field.
                               For now, we just allow dispatch. In real app, disable if already dispatched.
                            *@
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#dispatchModal-@item.DrugBatchId">
                                <i class="bi bi-truck"></i> Dispatch
                            </button>
                            
                            <!-- Modal for Dispatch -->
                            <div class="modal fade" id="dispatchModal-@item.DrugBatchId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="Dispatch" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Dispatch Batch @item.DrugBatchId</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="batchId" value="@item.DrugBatchId" />
                                                <div class="mb-3">
                                                    <label class="form-label">Select Distributor</label>
                                                    <select name="distributorId" class="form-select" required>
                                                        @* Ideally populated via ViewBag, but for list inside loop it's tricky.
                                                           We will load distributors via JS or simplified hardcode/ViewBag logic.
                                                           For the task, let's assume one distributor for simplicity or passed via ViewBag.
                                                        *@
                                                        <option value="">-- Select Distributor --</option>
                                                        @if(ViewBag.Distributors != null) {
                                                            foreach(var d in (IEnumerable<dynamic>)ViewBag.Distributors) {
                                                                <option value="@d.OrgId">@d.OrgName</option>
                                                            }
                                                        }
                                                        <option value="2">Default Distributor (Demo)</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                <button type="submit" class="btn btn-primary">Dispatch</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
