@model IEnumerable<DrugTracker.Models.ViewModels.BatchViewModel>

@{
    ViewData["Title"] = "Manufacturer Dashboard";
    int startCount = Model.Count(m => m.LatestAction == "CREATED" || m.LatestAction == "BATCH_CREATED");
    int dispatchCount = Model.Count(m => m.LatestAction == "TRANSFERRED" || m.LatestAction == "RECEIVED" || m.LatestAction == "ACCEPTED");
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="mb-1">Manufacturer Dashboard</h2>
            <p class="text-muted">Manage your drug production and shipments.</p>    
        </div>
        <a asp-action="CreateBatch" class="btn btn-primary-modern">
            <i class="bi bi-plus-lg me-2"></i>Create New Batch
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="dashboard-grid">
         <div class="card-modern" style="border-left: 5px solid var(--primary-color);">
            <div class="stat-card">
                <span class="stat-label">Total Batches</span>
                <span class="stat-value">@Model.Count()</span>
                 <div class="mt-2 text-muted small">
                    <i class="bi bi-box-seam me-1"></i> All time production
                </div>
            </div>
        </div>
        <div class="card-modern" style="border-left: 5px solid var(--secondary-color);">
             <div class="stat-card">
                <span class="stat-label">Ready to Dispatch</span>
                <span class="stat-value text-info">@startCount</span>
                 <div class="mt-2 text-muted small">
                    <i class="bi bi-hourglass-split me-1"></i> Awaiting shipment
                </div>
            </div>
        </div>
        <div class="card-modern" style="border-left: 5px solid #198754;">
             <div class="stat-card">
                <span class="stat-label">Dispatched</span>
                 <span class="stat-value text-success">@dispatchCount</span>
                  <div class="mt-2 text-muted small">
                    <i class="bi bi-truck me-1"></i> In transit/Delivered
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm" role="alert">
             <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Message"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
         <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
             <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="card-modern">
        <div class="card-header-modern">
            <h4 class="m-0">Recent Batches</h4>
        </div>
        <div class="table-responsive" style="overflow-x: auto;">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Batch ID</th>
                        <th>Drug Name</th>
                        <th>Quantity</th>
                        <th>Mfg Date</th>
                        <th>Exp Date</th>
                        <th>Status</th>
                        <th>Transferred To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-controller="Verification" asp-action="SupplyChain" asp-route-batchId="@item.Batch.DrugBatchId" class="text-primary text-decoration-none">
                                    #@item.Batch.DrugBatchId
                                </a>
                            </td>
                            <td>@item.Batch.Drug?.DrugName</td>
                            <td>@item.Batch.QuantityProduced</td>
                            <td>@item.Batch.ManufactureDate.ToShortDateString()</td>
                            <td>@item.Batch.ExpiryDate.ToShortDateString()</td>
                            <td>
                                @if(item.LatestAction == "TRANSFERRED" || item.LatestAction == "RECEIVED" || item.LatestAction == "ACCEPTED") {
                                    <span class="badge badge-success">Dispatched</span>
                                } else {
                                    <span class="badge badge-warning">Pending</span>
                                }
                            </td>
                            <td>@item.TransferredToOrgName</td>
                            <td class="text-end">
                                @if (item.IsActionEnabled)
                                {
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="EditBatch" asp-route-id="@item.Batch.DrugBatchId" class="btn btn-sm btn-secondary-modern" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-primary-modern" data-bs-toggle="modal" data-bs-target="#dispatchModal-@item.Batch.DrugBatchId" title="Dispatch">
                                            <i class="bi bi-truck"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger-modern" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Batch.DrugBatchId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-lock"></i> Locked</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals outside the table to prevent clipping issues -->
@foreach (var item in Model)
{
    @if (item.IsActionEnabled)
    {
         <!-- Modal for Dispatch -->
        <div class="modal fade" id="dispatchModal-@item.Batch.DrugBatchId" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <form asp-action="Dispatch" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title">Dispatch Batch @item.Batch.DrugBatchId</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-start">
                            <input type="hidden" name="batchId" value="@item.Batch.DrugBatchId" />
                            <div class="mb-3">
                                <label class="form-label">Select Distributor</label>
                                <select name="distributorId" class="form-control-modern" required>
                                    <option value="">-- Select Distributor --</option>
                                    @if(ViewBag.Distributors != null) {
                                        foreach(var d in (IEnumerable<dynamic>)ViewBag.Distributors) {
                                            <option value="@d.OrgId">@d.OrgName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary-modern">Dispatch</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal for Delete -->
        <div class="modal fade" id="deleteModal-@item.Batch.DrugBatchId" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <form asp-action="Delete" method="post">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">Delete Batch @item.Batch.DrugBatchId</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-start">
                            <p>Are you sure you want to delete this batch? This action cannot be undone.</p>
                            <input type="hidden" name="batchId" value="@item.Batch.DrugBatchId" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger-modern">Delete Batch</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
