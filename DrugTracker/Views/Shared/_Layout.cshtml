<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DrugTracker</title>
    <!-- Use Google Fonts - Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>

    @if (User.Identity.IsAuthenticated)
    {
        <div class="app-container">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="sidebar-header">
                    <i class="bi bi-shield-check" style="font-size: 2rem; color: var(--primary-color);"></i>
                    <span class="brand-logo">DrugTracker</span>
                </div>

                <ul class="nav-links">
                    
                    @if (User.IsInRole("Manufacturer"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Manufacturer" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Manufacturer" ? "active" : "")">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                    }
                    else if (User.IsInRole("Distributor"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Distributor" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Distributor" ? "active" : "")">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                    }
                    else if (User.IsInRole("Pharmacy"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Pharmacy" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Pharmacy" ? "active" : "")">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                    }

                    <!-- Common Links -->
                     <li class="nav-item">
                        <a asp-controller="Verification" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Verification" ? "active" : "")">
                            <i class="bi bi-search me-2"></i> Verify Drug
                        </a>
                    </li>
                </ul>

                <div class="user-profile">
                    <a href="#">
                        <i class="bi bi-person-circle me-2"></i> @User.Identity.Name
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </a>
                </div>
            </aside>

            <!-- Main Content -->
            <div class="main-content">
                <main role="main" class="content-wrapper">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout (No Sidebar) -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-light glass-nav py-3">
                <div class="container">
                    <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">DrugTracker</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-end">
                        <ul class="navbar-nav">
                             <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Verification" asp-action="Index">Track Medicine</a>
                            </li>
                             <li class="nav-item ms-3">
                                <a class="btn btn-primary-modern btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <main role="main">
            @RenderBody()
        </main>
         <footer class="border-top footer text-center py-4 bg-white text-muted">
            <div class="container">
                &copy; 2026 - DrugTracker - A Blockchain Initiative
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
