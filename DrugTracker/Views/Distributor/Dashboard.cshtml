@model IEnumerable<DrugTracker.Models.ViewModels.BatchViewModel>

@{
    ViewData["Title"] = "Distributor Dashboard";
    int incomingCount = Model.Count();
    int readyToDispatchCount = Model.Count(m => m.IsActionEnabled);
}

<div class="fade-in">
    <div class="d-flex justify-content-between align-items-center mb-5">
         <div>
            <h2 class="mb-1">Distributor Dashboard</h2>
            <p class="text-muted">Manage incoming shipments and pharmacy distribution.</p>    
        </div>
        <div class="text-end">
            <span class="badge badge-info">
                 <i class="bi bi-person-badge me-1"></i> @User.Identity?.Name
            </span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="dashboard-grid">
         <div class="card-modern" style="border-left: 5px solid var(--primary-color);">
            <div class="stat-card">
                <span class="stat-label">Incoming Batches</span>
                <span class="stat-value">@incomingCount</span>
                 <div class="mt-2 text-muted small">
                    <i class="bi bi-box-arrow-in-down me-1"></i> Received from Manufacturer
                </div>
            </div>
        </div>
        <div class="card-modern" style="border-left: 5px solid var(--secondary-color);">
             <div class="stat-card">
                <span class="stat-label">Ready for Pharmacy</span>
                <span class="stat-value text-secondary">@readyToDispatchCount</span>
                 <div class="mt-2 text-muted small">
                    <i class="bi bi-shop me-1"></i> Awaiting Dispatch
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm" role="alert">
             <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Message"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
         <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
             <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    <div class="card-modern">
        <div class="card-header-modern">
             <h4 class="m-0">Batch Management</h4>
        </div>
        <div class="table-responsive" style="overflow-x: auto;">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Batch ID</th>
                        <th>Drug Name</th>
                        <th>Qty</th>
                        <th>Mfg Date</th>
                        <th>Exp Date</th>
                        <th>Status</th>
                        <th>Transferred To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <a asp-controller="Verification" asp-action="SupplyChain" asp-route-batchId="@item.Batch.DrugBatchId" class="text-primary text-decoration-none">
                                    #@item.Batch.DrugBatchId
                                </a>
                            </td>
                            <td>@item.Batch.Drug?.DrugName</td>
                            <td>@item.Batch.QuantityProduced</td>
                            <td>@item.Batch.ManufactureDate.ToShortDateString()</td>
                            <td>@item.Batch.ExpiryDate.ToShortDateString()</td>
                            <td>
                                @if (item.IsActionEnabled)
                                {
                                    <span class="badge badge-info">Received</span>
                                }
                                else
                                {
                                     <span class="badge badge-success">Dispatched</span>
                                }
                            </td>
                            <td>@item.TransferredToOrgName</td>
                            <td class="text-end">
                                @if (item.IsActionEnabled)
                                {
                                    <button type="button" class="btn btn-sm btn-primary-modern" data-bs-toggle="modal" data-bs-target="#dispatchModal-@item.Batch.DrugBatchId">
                                        <i class="bi bi-truck me-1"></i> Dispatch
                                    </button>
                                }
                                else
                                {
                                     <button class="btn btn-sm btn-secondary-modern" disabled>Dispatched</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals outside the table -->
@foreach (var item in Model)
{
    @if (item.IsActionEnabled)
    {
        <!-- Modal -->
        <div class="modal fade" id="dispatchModal-@item.Batch.DrugBatchId" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <form asp-action="Dispatch" method="post">
                        <div class="modal-header">
                            <h5 class="modal-title">Dispatch Batch @item.Batch.DrugBatchId</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-start">
                            <input type="hidden" name="batchId" value="@item.Batch.DrugBatchId" />
                            <div class="mb-3">
                                <label class="form-label">Select Pharmacy</label>
                                <select name="pharmacyId" class="form-control-modern" required>
                                    <option value="">-- Select Pharmacy --</option>
                                    @if(ViewBag.Pharmacies != null) {
                                        foreach(var p in (IEnumerable<dynamic>)ViewBag.Pharmacies) {
                                            <option value="@p.OrgId">@p.OrgName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary-modern">Dispatch</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
