@model IEnumerable<DrugTracker.Models.DrugBatch>

@{
    ViewData["Title"] = "Distributor Dashboard";
}

<div class="container-fluid">
    <h2 class="mt-4"><i class="bi bi-box-seam"></i> Distributor Dashboard</h2>
    <hr />

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Batch ID</th>
                    <th>Drug Name</th>
                    <th>Quantity</th>
                    <th>Origin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@item.DrugBatchId</td>
                        <td>@item.Drug?.DrugName</td>
                        <td>@item.QuantityProduced</td>
                        <td>@item.CreatedByOrg?.OrgName</td>
                        <td>
                            <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#dispatchModal-@item.DrugBatchId">
                                <i class="bi bi-truck"></i> Dispatch to Pharmacy
                            </button>
                            
                            <!-- Modal -->
                            <div class="modal fade" id="dispatchModal-@item.DrugBatchId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="Dispatch" method="post">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Dispatch Batch @item.DrugBatchId</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="batchId" value="@item.DrugBatchId" />
                                                <div class="mb-3">
                                                    <label class="form-label">Select Pharmacy</label>
                                                    <select name="pharmacyId" class="form-select" required>
                                                        <option value="">-- Select Pharmacy --</option>
                                                        @if(ViewBag.Pharmacies != null) {
                                                            foreach(var p in (IEnumerable<dynamic>)ViewBag.Pharmacies) {
                                                                <option value="@p.OrgId">@p.OrgName</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                <button type="submit" class="btn btn-warning">Dispatch</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
